          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT player AS \"Joueur\", team AS \"Club\", position AS \"Poste\", age AS \"Âge\", nationality AS \"Nationalité\",\n  appearances AS \"MJ\", lineups AS \"Tit.\", minutes AS \"Min\", rating AS \"Note\",\n  goals AS \"Buts\", assists AS \"PD\", ga_p90 AS \"G+A/90\",\n  shots_total AS \"Tirs\", shots_on AS \"Cadrés\", conversion_pct AS \"Conv. %\",\n  passes_total AS \"Passes\", passes_key AS \"Passes clés\", passes_accuracy AS \"Passes réussies\",\n  tackles_total AS \"Tacles\", interceptions AS \"Interc.\", blocks AS \"Contres\",\n  duels_total AS \"Duels\", duels_won_pct AS \"Duels %\", dribbles_success AS \"Dribbles\", dribbles_success_pct AS \"Dribbles %\",\n  fouls_committed AS \"Fautes\", fouls_drawn AS \"Fautes subies\", yellow_cards AS \"CJ\", red_cards AS \"CR\",\n  saves AS \"Arrêts\", goals_conceded AS \"Encaissés\", penalty_scored AS \"Pen. marqués\", penalty_missed AS \"Pen. ratés\"\nFROM v_player_stats WHERE season = $season AND team IN ($club) AND position IN ($position) ORDER BY minutes DESC NULLS LAST"
        }
