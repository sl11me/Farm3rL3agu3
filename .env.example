# Copier ce fichier en .env puis remplir les valeurs (.env n'est jamais commité)

# --- PostgreSQL ---
POSTGRES_DB=farmerleague
POSTGRES_USER=farmer
POSTGRES_PASSWORD=change-me
# Mot de passe de l'utilisateur lecture seule utilisé par Grafana
GRAFANA_DB_PASSWORD=change-me-too

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-admin

# --- Collecteur API-Football (https://dashboard.api-football.com) ---
API_FOOTBALL_KEY=
# Saisons à collecter (année de début : 2024 = saison 2024/25), séparées par des virgules.
# Le plan gratuit ne donne pas accès à toutes les saisons : si l'API refuse, essayer une saison plus ancienne.
SEASONS=2024
INTERVAL_HOURS=24
# Plan gratuit : 10 requêtes/minute et 100/jour
REQUEST_DELAY_SECONDS=7
